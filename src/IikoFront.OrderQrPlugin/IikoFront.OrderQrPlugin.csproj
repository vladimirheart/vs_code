<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>IikoFront.OrderQrPlugin</AssemblyName>
    <RootNamespace>IikoFront.OrderQrPlugin</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Resto.Front.Api.V9Preview7" Version="9.4.6046-alpha" />
  </ItemGroup>

  <ItemGroup>
    <None Include="order-qr-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="manifest.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
