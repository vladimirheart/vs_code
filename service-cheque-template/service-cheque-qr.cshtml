@using System
@using System.Linq
@using System.Text
@using System.Collections
@using System.Collections.Generic
@using System.Globalization
@using System.Reflection
@functions {
    private const int PrinterQrCodePage = 866;
    private const bool UsePrinterTransportEncoding = false;

    private static object GetPropertyValue(object source, params string[] names)
    {
        if (source == null || names == null)
        {
            return null;
        }

        var type = source.GetType();
        foreach (var name in names)
        {
            var property = type.GetProperty(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.IgnoreCase);
            if (property == null)
            {
                continue;
            }

            try
            {
                return property.GetValue(source, null);
            }
            catch
            {
                return null;
            }
        }

        return null;
    }

    private static object GetPathValue(object source, params string[] paths)
    {
        if (source == null || paths == null)
        {
            return null;
        }

        foreach (var path in paths)
        {
            if (string.IsNullOrWhiteSpace(path))
            {
                continue;
            }

            object current = source;
            var parts = path.Split('.');
            var resolved = true;

            foreach (var part in parts)
            {
                current = GetPropertyValue(current, part);
                if (current == null)
                {
                    resolved = false;
                    break;
                }
            }

            if (resolved)
            {
                return current;
            }
        }

        return null;
    }

    private static IEnumerable<object> AsObjects(object value)
    {
        if (value == null || value is string)
        {
            yield break;
        }

        var enumerable = value as IEnumerable;
        if (enumerable == null)
        {
            yield break;
        }

        foreach (var item in enumerable)
        {
            if (item != null)
            {
                yield return item;
            }
        }
    }

    private static string ToText(object value, string fallback)
    {
        if (value == null)
        {
            return fallback;
        }

        var text = Convert.ToString(value, CultureInfo.InvariantCulture);
        return string.IsNullOrWhiteSpace(text) ? fallback : text.Trim();
    }

    private static string ToCompactNumber(object value, string fallback)
    {
        if (value == null)
        {
            return fallback;
        }

        decimal decimalValue;
        if (decimal.TryParse(Convert.ToString(value, CultureInfo.InvariantCulture), NumberStyles.Any, CultureInfo.InvariantCulture, out decimalValue))
        {
            return decimalValue.ToString("0.###", CultureInfo.InvariantCulture);
        }

        return ToText(value, fallback);
    }

    private static Encoding ResolveEncoding(int codePage)
    {
        try
        {
            return Encoding.GetEncoding(codePage);
        }
        catch
        {
            return Encoding.GetEncoding(866);
        }
    }

    private static string EncodeQrPayload(string payload)
    {
        if (string.IsNullOrEmpty(payload))
        {
            return string.Empty;
        }

        if (!UsePrinterTransportEncoding)
        {
            return payload;
        }

        var printerEncoding = ResolveEncoding(PrinterQrCodePage);
        return printerEncoding.GetString(Encoding.UTF8.GetBytes(payload));
    }

    private static string JoinNames(IEnumerable<object> source)
    {
        var values = new List<string>();
        foreach (var item in source)
        {
            var name = ToText(
                GetPropertyValue(item, "Name", "DisplayName", "Title", "FullName"),
                string.Empty);

            if (!string.IsNullOrWhiteSpace(name))
            {
                values.Add(name);
            }
        }

        return values.Count == 0 ? "-" : string.Join(", ", values.Distinct());
    }

    private static string FormatFoodValue(object item, params string[] propertyNames)
    {
        var value = GetPropertyValue(item, propertyNames);
        return ToCompactNumber(value, "-");
    }

    private static object ResolveOrder(object model)
    {
        return GetPropertyValue(model, "Order", "CurrentOrder", "Document", "SourceOrder") ?? model;
    }

    private static List<object> ResolveItems(object model, object order)
    {
        return AsObjects(
                GetPropertyValue(
                    order,
                    "Items",
                    "OrderItems",
                    "Products",
                    "ProductItems",
                    "Lines",
                    "Entries",
                    "GuestItems")
                ?? GetPropertyValue(
                    model,
                    "Items",
                    "OrderItems",
                    "Products",
                    "ProductItems",
                    "Lines",
                    "Entries",
                    "GuestItems"))
            .ToList();
    }

    private static string BuildPayload(object model)
    {
        var order = ResolveOrder(model);
        var orderNumber = ToText(GetPropertyValue(order, "Number", "OrderNumber"), "-");
        var items = ResolveItems(model, order);
        var builder = new StringBuilder();

        builder.Append("ЗАК:")
            .Append(orderNumber)
            .Append("; Д.:")
            .Append(DateTime.Now.ToString("yyyy-MM-ddTHH:mm:ss", CultureInfo.InvariantCulture))
            .Append("; ПОЗ.:")
            .Append(items.Count);

        for (var index = 0; index < items.Count; index++)
        {
            var item = items[index];
            var itemName = ToText(
                GetPathValue(
                    item,
                    "Name",
                    "ProductName",
                    "DishName",
                    "Title",
                    "Caption",
                    "Product.Name",
                    "Product.Title",
                    "ProductItem.Name",
                    "MenuItem.Name",
                    "Dish.Name",
                    "Item.Name"),
                "-");
            var quantity = ToCompactNumber(GetPropertyValue(item, "Amount", "Quantity", "Count"), "-");
            var size = ToText(GetPropertyValue(item, "Size", "SizeName", "PortionSize"), string.Empty);
            var allergens = JoinNames(AsObjects(GetPropertyValue(item, "Allergens", "AllergenGroups")));
            var modifiers = JoinNames(AsObjects(GetPropertyValue(item, "Modifiers", "ChildModifiers", "OrderModifiers")));

            builder.AppendLine()
                .Append(index + 1)
                .Append(";")
                .Append(itemName);

            builder.AppendLine()
                .Append("КОЛ:")
                .Append(quantity);

            if (!string.IsNullOrWhiteSpace(size) && size != "-")
            {
                builder.Append("; РАЗМЕР:")
                    .Append(size);
            }

            builder.AppendLine()
                .Append("ККАЛ:")
                .Append(FormatFoodValue(item, "Calories", "Kkal", "KCal", "EnergyKcal"))
                .Append("; Б:")
                .Append(FormatFoodValue(item, "Proteins", "Protein"))
                .Append("; Ж:")
                .Append(FormatFoodValue(item, "Fats", "Fat"))
                .Append("; У:")
                .Append(FormatFoodValue(item, "Carbohydrates", "Carbs"));

            builder.AppendLine()
                .Append("АЛГ:")
                .Append(allergens);

            if (modifiers != "-")
            {
                builder.AppendLine()
                    .Append("МОД.:")
                    .Append(modifiers);
            }
        }

        return builder.ToString();
    }
}
@{
    var payload = EncodeQrPayload(BuildPayload(Model));
}
<doc>
  <qrcode>@payload</qrcode>
</doc>
